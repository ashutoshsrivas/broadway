# ── Database (MySQL / MariaDB) ────────────────────────────────────────────────
# XAMPP default: user "root", empty password, port 3306.
DATABASE_URL="mysql://root:@localhost:3306/broadway_opticals"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-string"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# ── Razorpay (online payments) ────────────────────────────────────────────────
# Leave blank to run the store in Cash-on-Delivery-only mode.
# Test keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
