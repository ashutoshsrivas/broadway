// Broadway Opticals — Prisma schema
//
// Deliberately small. This is the bare-minimum surface an optical store needs
// to sell online: a catalogue (brand → product → colour variant), shoppers with
// addresses, and orders with a payment state. Anything an ERP would add —
// POS, loyalty, wallets, suppliers, stock transfers, exchanges — is out of
// scope by design and should stay out unless the shop actually needs it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// How much of the lens the frame encloses.
enum FrameType {
  FULL_RIM
  HALF_RIM
  RIMLESS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ──────────────────────────────────────────────────────────────────────────────
// PEOPLE
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  /// Null is allowed so an account can exist without a password later (social
  /// or OTP sign-in). The credentials provider rejects password-less accounts,
  /// so a null here can never be used to log in.
  password String?
  name     String
  phone    String?
  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]

  @@index([email])
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────────
// CATALOGUE
// ──────────────────────────────────────────────────────────────────────────────

/// Flat, on purpose. An optical store has a handful of departments
/// (Sunglasses, Eyeglasses, Computer Glasses, Contact Lenses, Accessories);
/// audience is a product attribute (`gender`), not a second tier of category.
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Brand {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  /// The brand's own logo, transparent PNG or WebP — what the "Our Brands"
  /// wall shows. Distinct from tileUrl, which is a photograph.
  logoUrl           String?
  /// Lifestyle photograph for the scrolling strip. A logo on white looks
  /// wrong there and a photo looks wrong on the logo wall, so these are two
  /// fields rather than one reused badly.
  tileUrl           String?
  /// Hero image at the top of the brand's own page.
  bannerUrl         String?
  /// A paragraph or two about the house, shown under that banner.
  description       String? @db.Text
  /// Shown in the homepage brand strip.
  isFeatured        Boolean @default(false)
  /// Gets a tab in the "New Arrivals" deck under the hero. Separate from
  /// isFeatured because the roll-call and the deck are different shelves —
  /// a house can be worth naming without having new stock worth showing.
  showInNewArrivals Boolean @default(false)
  /// Appears in the scrolling brand strip. Needs tileUrl to be worth showing,
  /// so the storefront filters on both.
  showInBrandStrip  Boolean @default(false)
  sortOrder         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])

  /// `mrp` is the printed/list price and `price` is what we actually charge.
  /// When price < mrp the storefront shows the struck-through MRP and a
  /// "SAVE x%" badge; there is no separate discount engine.
  mrp   Float
  price Float

  // ── Eyewear attributes (what the shop filters on) ──
  //
  // These are plain strings, not enums, because the shop floor has to be able
  // to coin a new shape or material mid-upload without a schema migration and
  // a redeploy. The known values live in AttributeValue, which is a vocabulary
  // for autocomplete — not a foreign key. Storing the text on the product
  // means a past product keeps the words it was filed under even if someone
  // later renames the vocabulary entry.
  gender          String     @default("Unisex")
  shape           String?
  material        String?
  /// Frame width as written on the arm — "52-18-140", "Medium", "52 mm".
  /// Free text because the shop writes it a dozen different ways.
  size            String?
  countryOfOrigin String?
  frameType       FrameType?
  /// Free text because lens options are a moving target (Blue-cut, Polarised,
  /// Photochromic, Progressive…). Not worth an enum.
  lensType        String?

  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  isLimitedEdition Boolean       @default(false)
  sortOrder        Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   ProductImage[]
  variants ProductVariant[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([gender])
  @@index([shape])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

/// One row per colourway. Stock lives here, never on Product — a frame is
/// bought in a specific colour, so that is the only level at which "in stock"
/// means anything.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku           String  @unique
  colorName     String
  colorHex      String?
  /// Overrides Product.price for this colourway only. Null = use the product price.
  priceOverride Float?
  stock         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
}

enum BannerMedia {
  IMAGE
  VIDEO
}

/// Where the caption sits over the media.
enum BannerAlign {
  LEFT
  CENTRE
  RIGHT
}

/// A full-screen slide in the homepage hero.
///
/// Managed entirely from /admin/banners — the storefront renders whatever is
/// active, in sortOrder, so the shop can run a campaign without a deploy.
model Banner {
  id        String      @id @default(cuid())
  mediaUrl  String
  mediaType BannerMedia @default(IMAGE)
  /// Still shown while a video loads, and the fallback if it cannot play.
  /// Also what a data-saver browser gets instead of downloading the video.
  posterUrl String?

  eyebrow    String?
  heading    String?
  subheading String?     @db.Text
  ctaLabel   String?
  ctaHref    String?
  align      BannerAlign @default(LEFT)

  /// How dark to veil the media so the caption stays legible, 0–80.
  /// A bright photo needs more than a moody one, and only the person who
  /// picked the photo knows which.
  overlay Int @default(35)

  /// How long this slide holds, in milliseconds, before advancing.
  durationMs Int @default(5000)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Small pieces of homepage configuration — which product the must-have
/// spotlight shows, which house the "Introducing" band features, the shop's
/// Instagram handle.
///
/// A key/value table rather than a column per setting: these are single
/// values an admin picks, and each new one would otherwise be a migration.
/// Anything with structure gets a real model instead.
model StoreSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// An editorial image dropped into the shop grid between products.
///
/// Breaks up a long run of frames-on-white with something worn on a face.
/// Occupies the footprint of four product cells, so the grid rhythm is
/// interrupted rather than merely decorated.
model ShopEditorial {
  id       String  @id @default(cuid())
  imageUrl String
  eyebrow  String?
  heading  String?
  /// Optional destination — a collection, a brand, a campaign page.
  href     String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// A post in the Instagram band. The image is ours (uploaded), the link
/// points at the real post, so the band works without an Instagram API token
/// and keeps working when the token would have expired.
model InstagramPost {
  id       String  @id @default(cuid())
  imageUrl String
  /// Link to the post itself. Falls back to the shop profile when empty.
  href     String?
  caption  String? @db.Text

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
}

/// One half of the split "Discover" band under the arrivals deck.
///
/// A list rather than a fixed him/her pair, so the shop can run three panels
/// for a season or swap in Kids without a migration. The storefront lays out
/// whatever is active in sortOrder.
model DiscoverPanel {
  id        String  @id @default(cuid())
  eyebrow   String?
  heading   String
  /// Video is optional: a panel is perfectly good as a still, and a shop
  /// without footage should not be left with an empty black rectangle.
  mediaUrl  String?
  /// Shown while the video loads, and the whole panel when there is none.
  /// Required, so a panel is never blank at first paint.
  posterUrl String
  /// Where clicking the panel goes, e.g. /shop?gender=Men
  href      String
  overlay   Int     @default(30)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// What kind of list a vocabulary entry belongs to.
enum AttributeKind {
  GENDER
  COLOUR
  MATERIAL
  SHAPE
  SIZE
  ORIGIN
}

/// The words the upload form offers, per field.
///
/// One table rather than six, because every one of these lists does exactly
/// the same job: remember what has been typed before so the next person picks
/// it instead of inventing a near-duplicate. New entries are written by the
/// upload form the moment someone commits an unrecognised word.
///
/// `slug` is the normalised form ("cat eye", "Cat-Eye" and "CAT EYE" all
/// collapse to "cat-eye") and carries the uniqueness constraint, so the list
/// cannot accumulate the same word three times in three casings. `label` is
/// what people actually see.
model AttributeValue {
  id    String        @id @default(cuid())
  kind  AttributeKind
  label String
  slug  String

  /// Bumped every time a product is saved with this value, so the combobox can
  /// offer the shop's real favourites first instead of alphabetical order.
  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, slug])
  @@index([kind, usageCount])
}

// ──────────────────────────────────────────────────────────────────────────────
// ORDERS
// ──────────────────────────────────────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  /// Human-facing reference (BO-2026-0001) shown on the order and in email.
  orderNumber String @unique

  /// Null for guest checkout. Signed-in orders carry the id so they appear
  /// under /account/orders.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Contact + shipping are snapshotted onto the order rather than joined to
  // Address, so editing or deleting an address never rewrites order history.
  email   String
  phone   String
  name    String
  line1   String
  line2   String?
  city    String
  state   String
  pincode String

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId   String?
  razorpayPaymentId String?

  /// Set once, inside the transaction that decrements variant stock, so a
  /// retried payment callback can never deduct the same order twice.
  stockDeducted Boolean @default(false)

  subtotal Float
  shipping Float @default(0)
  total    Float

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
}

/// Line items snapshot name/price/image at the time of purchase. The product
/// can be renamed, repriced or archived later without altering what the
/// customer actually bought.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  variantId String

  productName  String
  variantLabel String?
  sku          String?
  imageUrl     String?

  quantity   Int
  unitPrice  Float
  totalPrice Float

  @@index([orderId])
}
